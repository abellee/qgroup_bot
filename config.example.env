# 回调监听（HTTPS 由前面的 nginx 终结，这里只听本地端口）
QGB_LISTEN_ADDR=127.0.0.1:8092
QGB_READ_TIMEOUT=10s
QGB_UPSTREAM_TIMEOUT=8s
# 回调签名时间戳允许的时钟偏差；填 0s 关闭该检查
QGB_MAX_SKEW=5m

# QQ 机器人
QGB_QQ_APP_ID=
QGB_QQ_APP_SECRET=
QGB_QQ_API_BASE=https://api.bot.qq.com

# 只处理这些群，留空会拒绝启动
QGB_ALLOWED_GROUP_OPENIDS=

# sub2api 管理接口：鉴权用 x-api-key 头，列表接口只支持模糊的 search 参数，
# 因此代码会把返回的每一行邮箱与候选地址精确比对后才算命中
QGB_SUB2API_BASE=
QGB_SUB2API_ADMIN_KEY=
QGB_SUB2API_USER_ROUTE=/api/v1/admin/users

# 只批准、不拒绝：答案里的邮箱查不到就保持待审，等人工处理

# 用户 @机器人 时回到群里的 markdown（msg_type=2）。留空则不回复。
# 平台不接受无凭据的主动发送（40034105），也不能回复入群申请事件（40034027），
# 所以回复一定挂在消息事件上，用该消息的 id 当 msg_id。
# 需要在控制台开启群聊事件订阅（intent GROUP_AND_C2C_EVENT）：只 @机器人 时推
# GROUP_AT_MESSAGE_CREATE；「接收所有消息」推的是 GROUP_MESSAGE_CREATE，机器人
# 不会回它，免得刷屏。
# .env 里写不了真正的换行，这里用 \n 表示，程序读取时会展开。
# 这段文字只是占位，之后会换成对接大模型的回复。
QGB_CHAT_REPLY_MARKDOWN=## 收到\n\n我是机器人，暂时只会回这句话
