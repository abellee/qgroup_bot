# 回调监听（HTTPS 由前面的 nginx 终结，这里只听本地端口）
QGB_LISTEN_ADDR=127.0.0.1:8080
QGB_READ_TIMEOUT=10s
QGB_UPSTREAM_TIMEOUT=8s
# 回调签名时间戳允许的时钟偏差；填 0s 关闭该检查
QGB_MAX_SKEW=5m

# QQ 机器人
QGB_QQ_APP_ID=
QGB_QQ_APP_SECRET=
QGB_QQ_API_BASE=https://api.bot.qq.com

# 只处理这些群，留空会拒绝启动
QGB_ALLOWED_GROUP_OPENIDS=

# sub2api 管理接口（响应结构假定 {"code":0,"data":{"total":N}}，上服务器核实）
QGB_SUB2API_BASE=
QGB_SUB2API_ADMIN_KEY=
QGB_SUB2API_USER_ROUTE=/api/v1/admin/users

# 未通过时给用户的统一话术（不要暴露"邮箱未注册"这种可判定信息）
QGB_REJECT_REASON=入群申请未通过，请确认填写信息或联系管理员
