# 回调监听（HTTPS 由前面的 nginx 终结，这里只听本地端口）
QGB_LISTEN_ADDR=127.0.0.1:8092
QGB_READ_TIMEOUT=10s
QGB_UPSTREAM_TIMEOUT=8s
# 回调签名时间戳允许的时钟偏差；填 0s 关闭该检查
QGB_MAX_SKEW=5m

# QQ 机器人
QGB_QQ_APP_ID=
QGB_QQ_APP_SECRET=
QGB_QQ_API_BASE=https://api.bot.qq.com

# 只处理这些群，留空会拒绝启动
QGB_ALLOWED_GROUP_OPENIDS=

# sub2api 管理接口：鉴权用 x-api-key 头，列表接口只支持模糊的 search 参数，
# 因此代码会把返回的每一行邮箱与候选地址精确比对后才算命中
QGB_SUB2API_BASE=
QGB_SUB2API_ADMIN_KEY=
QGB_SUB2API_USER_ROUTE=/api/v1/admin/users

# 只批准、不拒绝：答案里的邮箱查不到就保持待审，等人工处理

# 后台（/admin）与模型回复
# SQLite 文件，存管理员账号和模型配置（含 API Key）。目录要能被容器里的
# uid 10001 写：mkdir -p data && chown 10001:10001 data && chmod 700 data。
# 打不开时只关掉后台和模型回复，入群审批照常工作。
QGB_DB_PATH=/data/qgroup.db

# 只在第一次启动、库里还没有账号时用来创建管理员；之后改这里不会再生成第二个。
# 密码超过 72 字节会被拒绝（bcrypt 的上限）。
QGB_ADMIN_USER=
QGB_ADMIN_PASSWORD=

# 模型配置在后台的「模型」菜单里填：提供商（OpenAI 兼容 / Anthropic / Gemini）、
# API 地址、API Key、模型名、人设，外加温度 / max tokens / 超时。
# @机器人 的消息会单轮发给启用的那条配置，模型答什么就回什么，不保存聊天记录。
# 后台不再挂在固定的 /admin 下：首次启动随机生成一段路径存进库，之后重启不变，
# 每次启动的日志都会打印。公网访问要在前面的 OpenResty 按这个路径
# proxy_pass 到 127.0.0.1:8092。
